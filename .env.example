# Docker Compose settings. Run make setup to create .env with generated secrets.
POSTGRES_DB=manufacturing_platform
POSTGRES_USER=manufacturing_platform
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_PORT=8083
FRONTEND_PORT=8082
GATEWAY_PORT=9002
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
SESSION_SECURE=false
SESSION_HOURS=12

# Shared machine-event secret and independent MCP integration credential.
# Generated once by infra/prepare-secrets.py; never commit .env.
MACHINE_EVENT_TOKEN=
ADMIN_INTEGRATION_TOKEN=
MACHINE_CALLBACK_URL=http://backend:8000/api/machine/events

# Human verification is configured per stage and requires no AI credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SIMULATOR_OPERATION_SECONDS=4

# Optional central lab database reader; use a read-only account, never commit secrets.
TELEMETRY_DATABASE_URL=
TELEMETRY_TIMEZONE=Asia/Kolkata
TELEMETRY_POLL_SECONDS=2
