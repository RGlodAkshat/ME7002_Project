# Copy to .env before running Docker Compose. Demo defaults are intentionally local-only.
POSTGRES_DB=smart_operator
POSTGRES_USER=smart_operator
POSTGRES_PASSWORD=smart_operator_demo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smart_operator:smart_operator_demo@postgres:5432/smart_operator

API_PORT=8083
FRONTEND_PORT=8082
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
EVIDENCE_DIR=/data/evidence

# auto selects OpenAI when a key is present and otherwise falls back to the mock provider.
VERIFICATION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Reference transport for future lab adapters. The POC backend uses its HTTP mock adapter.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_RFID_TOPIC=lab/rfid/+

# One lab gateway PC fronts all manufacturing devices. Its host and port are persisted
# at runtime from the supervisor UI; a fresh demo defaults to mock-devices:9002.
MOCK_GATEWAY_PORT=9002
