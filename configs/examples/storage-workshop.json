      "name": "Cut panels",
      "properties": {
        "completion_instructions": [
          "After the saw stops, remove the panels and check their dimensions.",
          "Inspect the cut edges and record offcuts or damaged panels before continuing."
        ],
        "instructions": [
          "Load the selected panels for {product.name} into {machine.name}.",
          "Use the panel dimensions recorded for the selected variants and follow the station's guarded-cut procedure."
        ]
      }
    },
    {
      "id": "drill-guide",
      "type": "guidance",
      "name": "Drill connection holes",
      "properties": {
        "completion_instructions": [
          "After the drill stops, remove the panels and inspect the hole pattern and edges.",
          "Record damaged panels before passing the components to assembly."
        ],
        "instructions": [
          "Use {machine.name} with the fixture appropriate to the selected panels.",
          "Drill the connection pattern and check the edges for splintering."
        ]
      }
    },
    {
      "id": "build-guide",
      "type": "guidance",
      "name": "Build storage shelf",
      "properties": {
        "instructions": [
          "Collect {parts}.",
          "Join the two side panels to the three shelf panels with the 16 supplied screws.",
          "Apply the selected finish kit. Check the unit sits level before inspection."
        ]
      }
