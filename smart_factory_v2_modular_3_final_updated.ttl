sfei:Event_OrderCompleted a sfe:OrderCompleted,
        owl:NamedIndividual ;
    rdfs:label "Event_OrderCompleted" ;
    sfe:hasEventTypeName "order_completed"^^xsd:string ;
    sfe:hasMetadataSchema "{order_id, total_duration_seconds}"^^xsd:string .

sfei:Event_OrderCreated a sfe:OrderCreated,
        owl:NamedIndividual ;
    rdfs:label "Event_OrderCreated" ;
    sfe:hasEventTypeName "order_created"^^xsd:string ;
    sfe:hasMetadataSchema "{order_id, product_id}"^^xsd:string .

sfei:Event_StepAdvanced a sfe:StepAdvanced,
        owl:NamedIndividual ;
    rdfs:label "Event_StepAdvanced" ;
    sfe:hasEventTypeName "step_advanced"^^xsd:string ;
    sfe:hasMetadataSchema "{order_id, from_step, to_step}"^^xsd:string .

sfei:Event_TagScanned a sfe:TagScanned,
        owl:NamedIndividual ;
    rdfs:label "Event_TagScanned" ;
    sfe:hasEventTypeName "tag_scanned"^^xsd:string ;
    sfe:hasMetadataSchema "{reader_id, tag_uid, role}"^^xsd:string .

sfei:Event_UnknownTag a sfe:UnknownTag,
        owl:NamedIndividual ;
    rdfs:label "Event_UnknownTag" ;
    sfe:hasEventTypeName "unknown_tag"^^xsd:string ;
    sfe:hasMetadataSchema "{tag_uid, reader_id}"^^xsd:string .

sfmachi:GET_health a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "GET_health" ;
    sfmach:exposedBy sfmachi:Gateway ;
    sfmach:hasHTTPMethod "GET"^^xsd:string ;
    sfmach:hasPath "/health"^^xsd:string .

sfmachi:GET_live a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "GET_live" ;
    sfmach:exposedBy sfmachi:Gateway ;
    sfmach:hasHTTPMethod "GET"^^xsd:string ;
    sfmach:hasPath "/live"^^xsd:string .

sfmachi:GET_orders a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "GET_orders" ;
    sfmach:exposedBy sfmachi:OrderService ;
    sfmach:hasHTTPMethod "GET"^^xsd:string ;
    sfmach:hasPath "/orders"^^xsd:string .

sfmachi:GET_orders_summary a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "GET_orders_summary" ;
    sfmach:exposedBy sfmachi:OrderService ;
    sfmach:hasHTTPMethod "GET"^^xsd:string ;
    sfmach:hasPath "/orders/{order_id}/summary"^^xsd:string .

sfmachi:GET_progress a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "GET_progress" ;
    sfmach:exposedBy sfmachi:TelemetryService ;
    sfmach:hasHTTPMethod "GET"^^xsd:string ;
    sfmach:hasPath "/progress/{order_id}"^^xsd:string .

sfmachi:Orchestrator a sfmach:Orchestrator,
        owl:NamedIndividual ;
    rdfs:label "Orchestrator" ;
    sfmach:hasFilename "reads.py"^^xsd:string ;
    sfmach:hasResponsibility "Rule-based RFID supervisor (in-process)"^^xsd:string ;
    sfmach:reads sfmachi:block,
        sfmachi:orders,
        sfmachi:rfid_tag,
        sfmachi:route_step ;
    sfmach:writes sfmachi:orders,
        sfmachi:read_event .

sfmachi:POST_orders a sfmach:APIEndpoint,
        owl:NamedIndividual ;
    rdfs:label "POST_orders" ;
    sfmach:exposedBy sfmachi:OrderService ;
    sfmach:hasHTTPMethod "POST"^^xsd:string ;
    sfmach:hasPath "/orders"^^xsd:string .

