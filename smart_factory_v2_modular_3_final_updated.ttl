sfmethi:Rule_R1_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R1.1: Siemens CNC Job Complete" ;
    sfmeth:hasAntecedent "machine in {MC1,MC2} AND status=Running AND all sub-codes seen AND MILLMAIN appears after sub-codes"^^xsd:string ;
    sfmeth:hasConsequent "Assert CompletionDetectionNode; trigger Route Step transition"^^xsd:string ;
    sfmeth:implementedIn "telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "CNC Completion"^^xsd:string ;
    sfmeth:ruleID "R1.1"^^xsd:string ;
    sfmeth:ruleName "Siemens CNC Job Complete"^^xsd:string .

sfmethi:Rule_R1_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R1.2: Fanuc CNC Job Complete" ;
    sfmeth:hasAntecedent "machine in {MC3,MC4} AND status=Running AND all sub-codes seen AND main program (02001/05001) appears after sub-codes"^^xsd:string ;
    sfmeth:hasConsequent "Assert CompletionDetectionNode; trigger Route Step transition"^^xsd:string ;
    sfmeth:implementedIn "telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "CNC Completion"^^xsd:string ;
    sfmeth:ruleID "R1.2"^^xsd:string ;
    sfmeth:ruleName "Fanuc CNC Job Complete"^^xsd:string .

sfmethi:Rule_R1_3 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R1.3: Program Code Normalization" ;
    sfmeth:hasAntecedent "Raw telemetry.prog contains path/extension/symbols"^^xsd:string ;
    sfmeth:hasConsequent "Strip /N_, O prefix, .MPF extension; produce canonical form"^^xsd:string ;
    sfmeth:implementedIn "telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "CNC Completion"^^xsd:string ;
    sfmeth:ruleID "R1.3"^^xsd:string ;
    sfmeth:ruleName "Program Code Normalization"^^xsd:string .

sfmethi:Rule_R2_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R2.1: Terminal Station (MC10) Complete" ;
    sfmeth:hasAntecedent "Consecutive telemetry_MC10 rows with Conveyor1_ON: True -> False"^^xsd:string ;
    sfmeth:hasConsequent "Assert CompletionDetectionNode at MC10; trigger Order Completed if final step"^^xsd:string ;
    sfmeth:implementedIn "telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "SMC Completion"^^xsd:string ;
    sfmeth:ruleID "R2.1"^^xsd:string ;
    sfmeth:ruleName "Terminal Station (MC10) Complete"^^xsd:string .

sfmethi:Rule_R2_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R2.2: Intermediate Station Complete (inferred)" ;
    sfmeth:hasAntecedent "Block tag scan at downstream SMC reader AND InProgress order has currentStep at upstream MC"^^xsd:string ;
    sfmeth:hasConsequent "Infer upstream completion; trigger step transitions for both"^^xsd:string ;
    sfmeth:implementedIn "reads.py + telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "SMC Completion"^^xsd:string ;
    sfmeth:ruleID "R2.2"^^xsd:string ;
    sfmeth:ruleName "Intermediate Station Complete (inferred)"^^xsd:string .

sfmethi:Rule_R3_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R3.1: OUT Tag Step Advance" ;
    sfmeth:hasAntecedent "TagScanned at OUT-role stationary tag AND rfid_tag.machine_id = order.expected_next_machine_id (GUARD)"^^xsd:string ;
    sfmeth:hasConsequent "Update orders.expected_next_op_seq, expected_next_machine_id; insert StepAdvanced"^^xsd:string ;
    sfmeth:implementedIn "reads.py"^^xsd:string ;
    sfmeth:ruleCategory "Step Advancement"^^xsd:string ;
    sfmeth:ruleID "R3.1"^^xsd:string ;
    sfmeth:ruleName "OUT Tag Step Advance"^^xsd:string .

sfmethi:Rule_R3_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R3.2: Telemetry Auto-Advance" ;
    sfmeth:hasAntecedent "CompletionDetectionNode fires AND no OUT tag scan within debounce"^^xsd:string ;
    sfmeth:hasConsequent "Same as R3.1; subsequent OUT scan no-ops via guard"^^xsd:string ;
    sfmeth:implementedIn "telemetry_service.py"^^xsd:string ;
    sfmeth:ruleCategory "Step Advancement"^^xsd:string ;
    sfmeth:ruleID "R3.2"^^xsd:string ;
    sfmeth:ruleName "Telemetry Auto-Advance"^^xsd:string .

sfmethi:Rule_R4_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R4.1: Product Location at Timestamp T" ;
    sfmeth:hasAntecedent "For (order_id, T): find latest read_event with metadata.order_id=order_id AND ts <= T"^^xsd:string ;
    sfmeth:hasConsequent "Classify by tag role: IN->AtMachine, OUT->InTransit, block->AtMachine"^^xsd:string ;
    sfmeth:implementedIn "Query helper"^^xsd:string ;
    sfmeth:ruleCategory "Location Resolution"^^xsd:string ;
    sfmeth:ruleID "R4.1"^^xsd:string ;
    sfmeth:ruleName "Product Location at Timestamp T"^^xsd:string .

sfmethi:Rule_R4_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R4.2: Factory-Wide Snapshot at T" ;
    sfmeth:hasAntecedent "For T: every order with status=InProgress at T"^^xsd:string ;
    sfmeth:hasConsequent "Apply R4.1 per order; return map"^^xsd:string ;
    sfmeth:implementedIn "Query helper"^^xsd:string ;
    sfmeth:ruleCategory "Location Resolution"^^xsd:string ;
    sfmeth:ruleID "R4.2"^^xsd:string ;
    sfmeth:ruleName "Factory-Wide Snapshot at T"^^xsd:string .

sfmethi:Rule_R5_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R5.1: Step Duration" ;
    sfmeth:hasAntecedent "IN-scan E1 at step S AND CompletionDetectionNode CN1 at S.machine_id"^^xsd:string ;
    sfmeth:hasConsequent "StepDuration = CN1.ts - E1.ts"^^xsd:string ;
    sfmeth:implementedIn "Query helper"^^xsd:string ;
    sfmeth:ruleCategory "Duration Computation"^^xsd:string ;
    sfmeth:ruleID "R5.1"^^xsd:string ;
    sfmeth:ruleName "Step Duration"^^xsd:string .

sfmethi:Rule_R5_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R5.2: Transit Duration" ;
    sfmeth:hasAntecedent "CN_prev at S_prev AND IN-scan E_next at S_next"^^xsd:string ;
    sfmeth:hasConsequent "TransitDuration = E_next.ts - CN_prev.ts"^^xsd:string ;
    sfmeth:implementedIn "Query helper"^^xsd:string ;
    sfmeth:ruleCategory "Duration Computation"^^xsd:string ;
    sfmeth:ruleID "R5.2"^^xsd:string ;
    sfmeth:ruleName "Transit Duration"^^xsd:string .

sfmethi:Rule_R5_3 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R5.3: Total Order Lead Time" ;
    sfmeth:hasAntecedent "orders.status=Completed"^^xsd:string ;
    sfmeth:hasConsequent "OrderDuration = orders.completed_at - orders.created_at"^^xsd:string ;
    sfmeth:implementedIn "OrderService.summary"^^xsd:string ;
    sfmeth:ruleCategory "Duration Computation"^^xsd:string ;
    sfmeth:ruleID "R5.3"^^xsd:string ;
    sfmeth:ruleName "Total Order Lead Time"^^xsd:string .

sfmethi:Rule_R6_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R6.1: Classify Tag Role" ;
    sfmeth:hasAntecedent "RFID scan: lookup rfid_tag.hardware_uid"^^xsd:string ;
    sfmeth:hasConsequent "role IN/OUT -> StationaryTagScan; role=block -> BlockScan; miss -> UnknownTag"^^xsd:string ;
    sfmeth:implementedIn "reads.py"^^xsd:string ;
    sfmeth:ruleCategory "Event Classification"^^xsd:string ;
    sfmeth:ruleID "R6.1"^^xsd:string ;
    sfmeth:ruleName "Classify Tag Role"^^xsd:string .

sfmethi:Rule_R6_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R6.2: Resolve Order from Block Scan" ;
    sfmeth:hasAntecedent "BlockScan with block_id: lookup block.product_id; find InProgress order"^^xsd:string ;
    sfmeth:hasConsequent "Bind scan to order_id; insert RFIDEventNode"^^xsd:string ;
    sfmeth:implementedIn "reads.py"^^xsd:string ;
    sfmeth:ruleCategory "Event Classification"^^xsd:string ;
    sfmeth:ruleID "R6.2"^^xsd:string ;
    sfmeth:ruleName "Resolve Order from Block Scan"^^xsd:string .

sfmethi:Rule_R7_1 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R7.1: Thread Creation" ;
    sfmeth:hasAntecedent "OrderCreated event fires"^^xsd:string ;
    sfmeth:hasConsequent "Instantiate DigitalThread; first node = StateTransitionNode(Created)"^^xsd:string ;
    sfmeth:implementedIn "order_service.py"^^xsd:string ;
    sfmeth:ruleCategory "Digital Thread"^^xsd:string ;
    sfmeth:ruleID "R7.1"^^xsd:string ;
    sfmeth:ruleName "Thread Creation"^^xsd:string .

sfmethi:Rule_R7_2 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R7.2: Thread Node Linking" ;
    sfmeth:hasAntecedent "New DigitalThreadNode at T_new"^^xsd:string ;
    sfmeth:hasConsequent "Set precededBy to latest existing node for thread"^^xsd:string ;
    sfmeth:implementedIn "All services"^^xsd:string ;
    sfmeth:ruleCategory "Digital Thread"^^xsd:string ;
    sfmeth:ruleID "R7.2"^^xsd:string ;
    sfmeth:ruleName "Thread Node Linking"^^xsd:string .

sfmethi:Rule_R7_3 a sfmeth:InferenceRule,
        owl:NamedIndividual ;
    rdfs:label "R7.3: Thread Finalization" ;
    sfmeth:hasAntecedent "Order -> Completed"^^xsd:string ;
    sfmeth:hasConsequent "Final node = StateTransitionNode(Completed); compute OrderDuration"^^xsd:string ;
    sfmeth:implementedIn "order_service.py"^^xsd:string ;
    sfmeth:ruleCategory "Digital Thread"^^xsd:string ;
    sfmeth:ruleID "R7.3"^^xsd:string ;
    sfmeth:ruleName "Thread Finalization"^^xsd:string .

sfmethi:Trans_SM2_1 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM2.1: Route Step: NotYet -> AtStep" ;
    sfmeth:fromState "NotYet"^^xsd:string ;
    sfmeth:guardDescription "rfid_tag.workstation = step.workstation AND op_seq match"^^xsd:string ;
    sfmeth:smID "SM2.1"^^xsd:string ;
    sfmeth:smName "Route Step"^^xsd:string ;
    sfmeth:toState "AtStep"^^xsd:string ;
    sfmeth:transitionAction "Mark step start"^^xsd:string ;
    sfmeth:triggerEvent "TagScanned at IN"^^xsd:string .

sfmethi:Trans_SM2_2 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM2.2: Route Step: AtStep -> Processing" ;
    sfmeth:fromState "AtStep"^^xsd:string ;
    sfmeth:guardDescription "Order at this step"^^xsd:string ;
    sfmeth:smID "SM2.2"^^xsd:string ;
    sfmeth:smName "Route Step"^^xsd:string ;
    sfmeth:toState "Processing"^^xsd:string ;
    sfmeth:transitionAction "Mark processing start"^^xsd:string ;
    sfmeth:triggerEvent "CNC start OR block arrives at SMC reader"^^xsd:string .

sfmethi:Trans_SM2_3 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM2.3: Route Step: Processing -> Completed" ;
    sfmeth:fromState "Processing"^^xsd:string ;
    sfmeth:guardDescription "Telemetry condition met"^^xsd:string ;
    sfmeth:smID "SM2.3"^^xsd:string ;
    sfmeth:smName "Route Step"^^xsd:string ;
    sfmeth:toState "Completed"^^xsd:string ;
    sfmeth:transitionAction "Mark end; compute StepDuration; insert CompletionDetectionNode"^^xsd:string ;
    sfmeth:triggerEvent "Completion rule fires"^^xsd:string .

sfmethi:Trans_SM2_4 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM2.4: Route Step: Completed -> AdvancedPast" ;
    sfmeth:fromState "Completed"^^xsd:string ;
    sfmeth:guardDescription "route_step.expected_next_machine_id matches (GUARD)"^^xsd:string ;
    sfmeth:smID "SM2.4"^^xsd:string ;
    sfmeth:smName "Route Step"^^xsd:string ;
    sfmeth:toState "AdvancedPast"^^xsd:string ;
    sfmeth:transitionAction "Advance op_seq; insert StepAdvanced"^^xsd:string ;
    sfmeth:triggerEvent "OUT tag scan OR auto-advance"^^xsd:string .

sfmethi:Trans_SM3_1 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM3.1: FMS Tray: AtFeeder -> OnConveyor" ;
    sfmeth:fromState "AtFeeder"^^xsd:string ;
    sfmeth:guardDescription "Block tag scan resolves order"^^xsd:string ;
    sfmeth:smID "SM3.1"^^xsd:string ;
    sfmeth:smName "FMS Tray"^^xsd:string ;
    sfmeth:toState "OnConveyor"^^xsd:string ;
    sfmeth:transitionAction "Record tray location"^^xsd:string ;
    sfmeth:triggerEvent "Tray departs MC5"^^xsd:string .

sfmethi:Trans_SM3_2 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM3.2: FMS Tray: OnConveyor -> AtStation" ;
    sfmeth:fromState "OnConveyor"^^xsd:string ;
    sfmeth:guardDescription "Block.product_id matches InProgress order"^^xsd:string ;
    sfmeth:smID "SM3.2"^^xsd:string ;
    sfmeth:smName "FMS Tray"^^xsd:string ;
    sfmeth:toState "AtStation"^^xsd:string ;
    sfmeth:transitionAction "Update tray location"^^xsd:string ;
    sfmeth:triggerEvent "Block tag scan at SMC reader"^^xsd:string .

sfmethi:Trans_SM3_3 a sfmeth:StateMachineTransition,
        owl:NamedIndividual ;
    rdfs:label "SM3.3: FMS Tray: AtStation -> OnConveyor" ;
    sfmeth:fromState "AtStation"^^xsd:string ;
    sfmeth:guardDescription "SMC completion rule fires"^^xsd:string ;
    sfmeth:smID "SM3.3"^^xsd:string ;
    sfmeth:smName "FMS Tray"^^xsd:string ;
    sfmeth:toState "OnConveyor"^^xsd:string ;
    sfmeth:transitionAction "Tray moves to next station"^^xsd:string ;
    sfmeth:triggerEvent "Completion at current station"^^xsd:string .

<http://smartfactory.lab/ontology> a owl:Ontology ;
    rdfs:label "Smart Factory Testbed Ontology v2" ;
    dcterms:description "Ontology for a lab-scale smart factory testbed. Models CNC machines, SMC FMS-200 automated stations, dual-mode RFID tracking (mobile tray reader + stationary SMC readers), product routing, and the digital thread." ;
    dcterms:title "Smart Factory Testbed Ontology" ;
    owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl> ;
    owl:versionInfo "2.1" .

sf:SmartFactoryTestbedOntologyV2 rdfs:comment "The ontology includes a local BFO 2020 bridge hierarchy for the BFO classes used by the Smart Factory ontology; the authoritative BFO ontology remains imported." .

sf:atSite a owl:ObjectProperty ;
    rdfs:label "atSite" ;
    rdfs:range sfe:SiteContext .

sf:isAbstract a owl:AnnotationProperty .

sfe:Approved a owl:Class ;
    rdfs:subClassOf sfe:MaterialState .

sfe:Completed a owl:Class ;
    rdfs:label "Completed" ;
    rdfs:comment "Material/order has completed the intended production route; retained as a compatibility bridge for legacy OrderStatus." ;
    rdfs:subClassOf sfe:MaterialState .

sfe:Created a owl:Class ;
    rdfs:label "Created" ;
    rdfs:comment "Material/order exists but production has not begun; retained as a compatibility bridge for legacy OrderStatus." ;
    rdfs:subClassOf sfe:MaterialState .

sfe:Faulted a owl:Class ;
    rdfs:subClassOf sfe:OperationalState .

sfe:Idle a owl:Class ;
    rdfs:subClassOf sfe:ActivityState .

sfe:InProcess a owl:Class ;
    rdfs:subClassOf sfe:MaterialState .

sfe:InTransit a owl:Class ;
    rdfs:subClassOf sfe:MaterialState .

sfe:InspectionCompleted a owl:Class ;
    rdfs:subClassOf sfe:InspectionEvent .

sfe:InspectionStarted a owl:Class ;
    rdfs:subClassOf sfe:InspectionEvent .

sfe:LocatedAtWorkstation a owl:Class ;
    rdfs:subClassOf sfe:MaterialState .

sfe:LocationFact a owl:Class ;
    rdfs:label "LocationFact" ;
    rdfs:comment "A subject was located at an object during [validFrom, validUntil)." ;
    rdfs:subClassOf sfe:TemporalAssertion .

sfe:MachineFaultCleared a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineFaultOccurred a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineProcessingCompleted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineProcessingStarted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineSetupCompleted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineSetupStarted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineStarted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MachineStopped a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:Maintenance a owl:Class ;
    rdfs:subClassOf sfe:OperationalState .

sfe:MaintenanceCompleted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MaintenanceStarted a owl:Class ;
    rdfs:subClassOf sfe:MachineEvent .

sfe:MaterialArrivedAtWorkstation a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialCompleted a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialCreated a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialDepartedFromWorkstation a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialPositioned a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialRemovedFromWorkstation a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialTransportCompleted a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MaterialTransportStarted a owl:Class ;
    rdfs:subClassOf sfe:MaterialEvent .

sfe:MeasurementCompleted a owl:Class ;
    rdfs:subClassOf sfe:MeasurementState .

sfe:MeasurementInProgress a owl:Class ;
    rdfs:subClassOf sfe:MeasurementState .

sfe:MeasurementPending a owl:Class ;
    rdfs:subClassOf sfe:MeasurementState .

sfe:Off a owl:Class ;
    rdfs:subClassOf sfe:OperationalState .

sfe:OperationCompleted a owl:Class ;
    rdfs:subClassOf sfe:ProcessEvent .

sfe:OperationInProgress a owl:Class ;
    rdfs:subClassOf sfe:MethodState .

sfe:OperationInterrupted a owl:Class ;
    rdfs:subClassOf sfe:ProcessEvent .

