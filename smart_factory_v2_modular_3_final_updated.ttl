sfmeth:assignedToMachine a owl:ObjectProperty ;
    rdfs:label "assignedToMachine" ;
    rdfs:domain sfmeth:RouteStep ;
    rdfs:range sfmach:Machine ;
    owl:inverseOf sfmach:performsStep .

sfmeth:hasDuration a owl:ObjectProperty ;
    rdfs:label "hasDuration" ;
    rdfs:domain sfmeth:Operation ;
    rdfs:range sfe:StepDuration ;
    owl:inverseOf sfe:durationOf .

sfmeth:hasProgramSequence a owl:ObjectProperty ;
    rdfs:label "hasProgramSequence" ;
    rdfs:domain sfmeth:RouteStep ;
    rdfs:range sfmach:ProgramSequence ;
    owl:inverseOf sfmach:requiredAtStep .

sfmeth:nextStep a owl:ObjectProperty ;
    rdfs:label "nextStep" ;
    rdfs:domain sfmeth:RouteStep ;
    rdfs:range sfmeth:RouteStep ;
    owl:inverseOf sfmeth:previousStep .

sfmeth:operationFor a owl:ObjectProperty ;
    rdfs:label "operationFor" ;
    rdfs:domain sfmeth:Operation ;
    rdfs:range sfe:Order ;
    owl:inverseOf sfe:performsOperation .

sfmeth:previousStep a owl:ObjectProperty ;
    rdfs:label "previousStep" ;
    rdfs:domain sfmeth:RouteStep ;
    rdfs:range sfmeth:RouteStep ;
    owl:inverseOf sfmeth:nextStep .

sfmeth:routeStepFor a owl:ObjectProperty ;
    rdfs:label "routeStepFor" ;
    rdfs:domain sfmeth:RouteStep ;
    rdfs:range sfmatl:Product ;
    owl:inverseOf sfmatl:hasRouteStep .

