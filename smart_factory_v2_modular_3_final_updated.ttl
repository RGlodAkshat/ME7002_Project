sfe:MaterialEvent a owl:Class ;
    rdfs:subClassOf sfe:Event .

sfe:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A production order; live state in orders table." ;
    rdfs:subClassOf obo:BFO_0000031 .

sfmeth:StateMachineTransition a owl:Class ;
    rdfs:label "StateMachineTransition" ;
    rdfs:comment "A legal state transition with trigger, guard, action." ;
    rdfs:subClassOf obo:BFO_0000031 .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant" ;
    rdfs:subClassOf obo:BFO_0000002 .

sfmatl:StationaryTag a owl:Class ;
    rdfs:label "StationaryTag" ;
    rdfs:comment "RFID tag mounted at a workstation or machine; scanned by the mobile tray reader. Carries IN/OUT role semantics." ;
    rdfs:subClassOf sfmatl:TrackingTag .

sfmeth:Operation a owl:Class ;
    rdfs:label "Operation" ;
    rdfs:comment "A defined type/specification of work to be performed; an execution of an Operation is represented by a ProductionProcess." ;
    rdfs:subClassOf obo:BFO_0000031 .

sfmach:Microservice a owl:Class ;
    rdfs:label "Microservice" ;
    sf:isAbstract true ;
    rdfs:comment "Abstract: any service in the architecture." ;
    rdfs:subClassOf obo:BFO_0000030 .

sfmatl:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "The physical workpiece being manufactured. Has a BOM and a route." ;
    rdfs:subClassOf sfmatl:PhysicalAsset .

sfei:SmartFactoryLab a sfe:Factory,
        owl:NamedIndividual ;
    rdfs:label "Smart Factory Testbed Lab" .

sfe:DigitalThreadNode a owl:Class ;
    rdfs:label "DigitalThreadNode" ;
    sf:isAbstract true ;
    rdfs:comment "Abstract: any node in a digital thread." ;
    rdfs:subClassOf obo:BFO_0000031 .

sfmach:SubCode a owl:Class ;
    rdfs:label "SubCode" ;
    rdfs:comment "CNC sub-program executed before main program." ;
    rdfs:subClassOf sfmach:ProgramSequence .

sfmach:DatabaseTable a owl:Class ;
    rdfs:label "DatabaseTable" ;
    rdfs:comment "A relational table in PostgreSQL." ;
    rdfs:subClassOf sfmach:DataStore .

sfmach:Workstation a owl:Class ;
    rdfs:label "Workstation" ;
    rdfs:comment "Workstation where work happens on the product (kitting, machining, assembly, etc.)." ;
    rdfs:subClassOf sfmach:Equipment .

sfmach:Machine a owl:Class ;
    rdfs:label "Machine" ;
    sf:isAbstract true ;
    rdfs:comment "Abstract: any machine that processes a product." ;
    rdfs:subClassOf sfmach:Equipment .

sfmeth:InferenceRule a owl:Class ;
    rdfs:label "InferenceRule" ;
    rdfs:comment "A declarative IF-THEN rule the agent applies." ;
    rdfs:subClassOf obo:BFO_0000031 .

sfmatl:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:comment "A component in a BOM (gear, blade, base, pin, handle, etc.)." ;
    rdfs:subClassOf obo:BFO_0000030 .

sfmatl:BOMLine a owl:Class ;
    rdfs:label "BOMLine" ;
    rdfs:comment "Reified BOM entry: one (BOM, Component, quantity) row. Replaces hasQuantity being asserted directly on Component, which was ambiguous for components shared across multiple BOMs (e.g. gears G1-G5)." ;
    rdfs:subClassOf obo:BFO_0000031 .

sfmeth:RouteStep a owl:Class ;
    rdfs:label "RouteStep" ;
    rdfs:comment "One operation in a product manufacturing route, keyed by (product_id, op_seq)." ;
    rdfs:subClassOf obo:BFO_0000031 .

