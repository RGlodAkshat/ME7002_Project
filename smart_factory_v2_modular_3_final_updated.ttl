sfmachi:bom a sfmach:DatabaseTable,
        owl:NamedIndividual ;
    rdfs:label "bom" ;
    sfmach:hasColumnList "product_id,component_id,name,quantity,colour"^^xsd:string ;
    sfmach:hasPrimaryKey "(product_id,component_id)"^^xsd:string ;
    sfmach:hasTableName "bom"^^xsd:string ;
    sfmach:isHypertable false .

sfmachi:machine a sfmach:DatabaseTable,
        owl:NamedIndividual ;
    rdfs:label "machine" ;
    sfmach:hasColumnList "machine_id,workstation_id,machine_type"^^xsd:string ;
    sfmach:hasPrimaryKey "machine_id"^^xsd:string ;
    sfmach:hasTableName "machine"^^xsd:string ;
    sfmach:isHypertable false .

sfmachi:operator a sfmach:DatabaseTable,
        owl:NamedIndividual ;
    rdfs:label "operator" ;
    sfmach:hasColumnList "operator_id,name,role"^^xsd:string ;
    sfmach:hasPrimaryKey "operator_id"^^xsd:string ;
    sfmach:hasTableName "operator"^^xsd:string ;
    sfmach:isHypertable false .

sfmachi:tray a sfmach:DatabaseTable,
        owl:NamedIndividual ;
    rdfs:label "tray" ;
    sfmach:hasColumnList "detection_entity,reader_id"^^xsd:string ;
    sfmach:hasPrimaryKey "detection_entity"^^xsd:string ;
    sfmach:hasTableName "tray"^^xsd:string ;
    sfmach:isHypertable false .

sfmachi:workstation a sfmach:DatabaseTable,
        owl:NamedIndividual ;
    rdfs:label "workstation" ;
    sfmach:hasColumnList "workstation_id,description,station_type,operation_type,operation_id"^^xsd:string ;
    sfmach:hasPrimaryKey "workstation_id"^^xsd:string ;
    sfmach:hasTableName "workstation"^^xsd:string ;
    sfmach:isHypertable false .

